// The full data model is specified in docs/dev/DEV_PLAN.md section 4, and is
// modelled here table by table as each subsystem is built.
//
// Built: Member, AuthToken, Event, Registration, AttendanceRecord,
// Deliverable, Credential, CredentialSkill, CredentialEvent,
// VerificationCheck, Skill, MemberSkill, ActivityEntry, Opportunity.
// Phase 1 additions: Role, MemberRole, AuditLog, CompletionRule,
// ActivityCompletion, Album, MediaItem, Project, ProjectMember,
// ProjectMilestone, ActivitySkill, EventStatus enum, Opportunity extensions.
//
// Three rules from that section the schema has to keep:
//   - AttendanceRecord.clientEventId is unique. It is the idempotency key
//     that makes offline check-in replay safe.
//   - Credential is immutable once issued and survives membership lapse, so
//     nothing may cascade a delete onto it.
//   - MemberSkill.level is derived. There is no write path for a member.

generator client {
  provider = "prisma-client-js"
}

// Neon. DATABASE_URL is the pooled connection the app uses; DIRECT_URL
// bypasses the pooler, which is what migrations need - they run DDL that a
// connection pooler cannot hold open. Both come from the Neon dashboard.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Department {
  MECHANICAL
  MECHATRONICS
}

enum FresherSubmissionType {
  REQUEST
  INQUIRY
  COMPLAINT
  OTHER
}

enum FresherIssueArea {
  ROOM_AND_HOSTEL
  ARRIVAL_AND_DIRECTIONS
  REGISTRATION
  FEES
  ACADEMIC
  SAFETY
  OTHER
}

enum FresherSubmissionStatus {
  NEW
  IN_PROGRESS
  RESOLVED
}

enum MemberStatus {
  PENDING
  ACTIVE
  LAPSED
  ALUMNUS
}

enum TokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

// ---------------------------------------------------------------------------
// Roles
// ---------------------------------------------------------------------------

enum RoleKey {
  MEMBER
  EXECUTIVE
  PRESIDENT
  ADMIN
  CONTENT_MANAGER
  PROJECT_LEAD
}

/// A named role that can be granted to a member.
model Role {
  id    String  @id @default(cuid())
  key   RoleKey @unique
  label String

  memberRoles MemberRole[]
}

/// A many-to-many join granting a Role to a Member.
model MemberRole {
  id       String @id @default(cuid())
  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  roleId   String
  role     Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  grantedBy String?
  grantedAt DateTime @default(now())

  @@unique([memberId, roleId])
}

// ---------------------------------------------------------------------------
// Audit log
// ---------------------------------------------------------------------------

enum AuditAction {
  MEMBER_APPROVED
  MEMBER_REJECTED
  ROLE_GRANTED
  ROLE_REVOKED
  EVENT_PUBLISHED
  EVENT_CANCELLED
  ATTENDANCE_EDITED
  CREDENTIAL_ISSUED
  CREDENTIAL_REVOKED
  OPPORTUNITY_PUBLISHED
  OPPORTUNITY_REJECTED
  SETTINGS_UPDATED
}

/// Append-only record of every admin/exec action. The actor field is nullable
/// because accounts can be deleted, and deleting an account must not silently
/// erase history.
model AuditLog {
  id         String      @id @default(cuid())
  actorId    String?
  actor      Member?     @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     AuditAction
  entityType String
  entityId   String
  diff       Json?
  createdAt  DateTime    @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
}

// ---------------------------------------------------------------------------
// Completion rules and activity completions
// ---------------------------------------------------------------------------

enum CompletionRuleKind {
  ATTENDANCE_ONLY
  ATTENDANCE_PLUS_DELIVERABLE
  MANUAL_APPROVAL
}

/// A reusable rule that says what a member must do to "complete" an activity.
model CompletionRule {
  id                   String             @id @default(cuid())
  name                 String
  kind                 CompletionRuleKind @default(ATTENDANCE_ONLY)
  minContactHours      Int                @default(0)
  requiresDeliverable  Boolean            @default(false)
  requiresAssessment   Boolean            @default(false)
  minScore             Int                @default(0)
  createdAt            DateTime           @default(now())

  events      Event[]
  completions ActivityCompletion[]
}

/// Records that a member has completed an activity (event or project).
model ActivityCompletion {
  id               String          @id @default(cuid())
  memberId         String
  member           Member          @relation(fields: [memberId], references: [id], onDelete: Cascade)
  sourceType       String
  sourceId         String
  completedAt      DateTime        @default(now())
  approvedBy       String?
  approver         Member?         @relation("CompletionApprover", fields: [approvedBy], references: [id], onDelete: SetNull)
  completionRuleId String?
  completionRule   CompletionRule? @relation(fields: [completionRuleId], references: [id], onDelete: SetNull)

  @@unique([memberId, sourceType, sourceId])
}

// ---------------------------------------------------------------------------
// Gallery: albums and media items
// ---------------------------------------------------------------------------

/// A named collection of media, optionally tied to an event.
model Album {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  description String?
  coverUrl    String?
  eventId     String?
  event       Event?    @relation(fields: [eventId], references: [id], onDelete: SetNull)
  publishedAt DateTime?
  createdById String
  createdBy   Member    @relation("AlbumCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime  @default(now())

  items MediaItem[]
}

/// A single photo or video link inside an Album.
model MediaItem {
  id           String   @id @default(cuid())
  albumId      String
  album        Album    @relation(fields: [albumId], references: [id], onDelete: Cascade)
  url          String
  thumbnailUrl String?
  altText      String
  kind         String   @default("PHOTO")
  width        Int?
  height       Int?
  uploadedById String
  uploadedBy   Member   @relation("MediaItemUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  createdAt    DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Projects
// ---------------------------------------------------------------------------

/// A branch project, independent of any event.
model Project {
  id            String    @id @default(cuid())
  slug          String    @unique
  title         String
  description   String?
  status        String    @default("PROPOSED")
  startedOn     DateTime?
  completedOn   DateTime?
  leadMemberId  String?
  leadMember    Member?   @relation("ProjectLead", fields: [leadMemberId], references: [id], onDelete: SetNull)
  isPublic      Boolean   @default(false)
  createdAt     DateTime  @default(now())

  members    ProjectMember[]
  milestones ProjectMilestone[]
}

/// A member's participation in a project.
model ProjectMember {
  projectId        String
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  memberId         String
  member           Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  role             String
  joinedAt         DateTime @default(now())
  contributionNote String?

  @@id([projectId, memberId])
}

/// A milestone within a project.
model ProjectMilestone {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  dueOn       DateTime?
  completedOn DateTime?
  status      String    @default("PENDING")
}

// ---------------------------------------------------------------------------
// Activity skills — a cross-source skill tag
// ---------------------------------------------------------------------------

/// Links a skill to an activity source (event or project) by type/id pair.
model ActivitySkill {
  sourceType String
  sourceId   String
  skillId    String
  skill      Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([sourceType, sourceId, skillId])
}

/// A person with an account. Membership is not the same as an account: anyone
/// can register, and `status` moves to ACTIVE only once an executive has
/// verified them against the department roll (dev plan section 6.1).
model Member {
  id       String @id @default(cuid())
  email    String @unique
  fullName String

  /// bcrypt. Never logged, never emailed, never returned by any query that
  /// feeds a response - `select` it explicitly, only where it is compared.
  passwordHash String

  /// Set when the member opens the link we emailed them. Null means the
  /// address has not been proven to belong to them yet.
  emailVerifiedAt DateTime?

  department Department?
  level      Int?

  /// Tech-U matric number, e.g. 125/23/1/0142 -
  ///   125   programme code
  ///   23    year of entry
  ///   1     1 male, 2 female
  ///   0142  the student's number on the school list for that year
  /// Never typed by a member. It is read off the department roll when an
  /// executive approves them (dev plan section 6.1), which is what lets the
  /// review queue say "matched on the roll" instead of asking anyone to check.
  matricNo String? @unique

  status MemberStatus @default(PENDING)

  /// Branch membership number, e.g. SF-TECHU-0142. Issued by the branch, not
  /// the school, and unlike matricNo it survives graduation - an alumnus keeps
  /// it, and a certificate issued years ago still points at it.
  memberNo String? @unique

  /// When the branch admitted them, which is not when the account was created:
  /// a member can register in October and be approved in November.
  joinedAt DateTime?

  /// Year they are expected to graduate. Shown on the profile, and what turns
  /// a member into an ALUMNUS without anyone running a script by hand.
  expectedGraduation Int?

  /// Executive office held this session - "President", "Technical Secretary".
  /// Null for an ordinary member. Offices are annual, so this is a label on
  /// the person rather than a role the authorisation layer reads.
  execTitle String?

  /// Opt-in shareable page at /u/<publicSlug>. Off until the member turns it
  /// on, so nothing about them is public by accident (design plan 1.4).
  publicSlug    String? @unique
  publicProfile Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tokens        AuthToken[]
  registrations Registration[]
  attendance    AttendanceRecord[]
  deliverables  Deliverable[]
  credentials   Credential[]
  skills        MemberSkill[]
  activity      ActivityEntry[]

  // Phase 1 additions
  memberRoles              MemberRole[]
  auditLogs                AuditLog[]
  completions              ActivityCompletion[]
  completionsApproved      ActivityCompletion[]   @relation("CompletionApprover")
  albumsCreated            Album[]                @relation("AlbumCreator")
  mediaItemsUploaded       MediaItem[]            @relation("MediaItemUploader")
  projectsLed              Project[]              @relation("ProjectLead")
  projectMemberships       ProjectMember[]
  opportunitiesSubmitted   Opportunity[]          @relation("OpportunitySubmitter")
  opportunitiesReviewed    Opportunity[]          @relation("OpportunityReviewer")

  @@index([status])
}

/// A new student using the public fresher support flow before they have a
/// matric number or a full member account. The random token is stored only as
/// a hash; the corresponding raw token lives in an HTTP-only browser cookie.
model FresherIntake {
  id              String   @id @default(cuid())
  fullName        String
  phone           String
  department      Department
  accessTokenHash String   @unique
  accessExpiresAt DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  submissions FresherSubmission[]

  @@index([createdAt])
}

/// Requests, inquiries, complaints and other issues sent by freshers. Every
/// submission is visible to executives in the shared fresher support queue.
model FresherSubmission {
  id        String                   @id @default(cuid())
  fresherId String
  fresher   FresherIntake            @relation(fields: [fresherId], references: [id], onDelete: Cascade)
  type      FresherSubmissionType
  area      FresherIssueArea
  subject   String
  message   String                   @db.Text
  status    FresherSubmissionStatus  @default(NEW)
  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt

  @@index([status, createdAt])
  @@index([fresherId, createdAt])
}

/// Email verification and password reset, in one table because they behave
/// identically: single use, short lived, and worthless once spent.
///
/// The token itself is never stored - only a SHA-256 of it. A dump of this
/// table is then a list of expiry dates rather than a set of working links
/// into other people's accounts.
model AuthToken {
  id        String       @id @default(cuid())
  tokenHash String       @unique
  purpose   TokenPurpose
  memberId  String
  member    Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime     @default(now())

  @@index([memberId, purpose])
}

// ---------------------------------------------------------------------------
// Events, and the three things a member can do with one: register for it, be
// checked in at it, and owe something afterwards.
// ---------------------------------------------------------------------------

enum EventMode {
  IN_PERSON
  ONLINE
  HYBRID
}

enum EventKind {
  PLANT_VISIT
  TRAINING
  LECTURE
  CAREERS
  COMPETITION
  MEETING
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

model Event {
  id      String    @id @default(cuid())
  slug    String    @unique
  title   String
  kind    EventKind
  summary String?

  startsAt DateTime
  endsAt   DateTime?

  mode     EventMode   @default(IN_PERSON)
  status   EventStatus @default(DRAFT)

  /// Room, gate or meeting platform. One line, as it is read off a phone on
  /// the way there - not an address block.
  location String?
  /// Who is running it, where that is a person: "Engr. John Doe".
  host     String?
  /// What to bring or wear. Shown on the member's own event list because it is
  /// the thing people turn up without.
  notes    String?

  /// Counts toward the hours printed on a certificate, so it is stored per
  /// event rather than worked out from start and end times - a four-hour
  /// visit with two hours of travel is not four contact hours.
  contactHours Int @default(0)

  /// Places available, or null for unlimited. Registration does not enforce
  /// it yet; the executive screens will.
  capacity Int?

  /// Optional completion rule attached to this event.
  completionRuleId String?
  completionRule   CompletionRule? @relation(fields: [completionRuleId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  registrations Registration[]
  attendance    AttendanceRecord[]
  deliverables  Deliverable[]
  credentials   CredentialEvent[]
  albums        Album[]

  @@index([startsAt])
  @@index([status, startsAt])
}

/// A member said they are coming. Separate from attendance on purpose: the gap
/// between the two is the number the executive screens care about.
model Registration {
  id       String @id @default(cuid())
  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  eventId  String
  event    Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  createdAt   DateTime  @default(now())
  cancelledAt DateTime?

  @@unique([memberId, eventId])
  @@index([eventId])
}

/// A member was present. Written by the check-in screen, which runs offline at
/// a plant gate with no signal and replays when it comes back.
model AttendanceRecord {
  id       String @id @default(cuid())
  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  eventId  String
  event    Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  checkedInAt DateTime @default(now())

  /// The idempotency key. The offline client mints it before the request
  /// leaves the device, so a replayed queue writes one row rather than five
  /// (dev plan section 4). Unique across the table, not per member.
  clientEventId String @unique

  createdAt DateTime @default(now())

  @@unique([memberId, eventId])
  @@index([eventId])
}

enum DeliverableKind {
  VISIT_NOTE
  PROJECT_REPORT
  ASSESSMENT
}

/// Something the member still owes after an event. This is what stands between
/// attendance and a certificate, and it is why the dashboard can say "the last
/// thing between you and that certificate" rather than going quiet.
model Deliverable {
  id       String          @id @default(cuid())
  memberId String
  member   Member          @relation(fields: [memberId], references: [id], onDelete: Cascade)
  eventId  String
  event    Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  kind     DeliverableKind

  dueAt       DateTime
  submittedAt DateTime?

  createdAt DateTime @default(now())

  @@unique([memberId, eventId, kind])
  @@index([memberId, submittedAt])
}

// ---------------------------------------------------------------------------
// Certificates, and the skills they evidence.
// ---------------------------------------------------------------------------

/// Issued, immutable, and deliberately not cascaded from Member: a certificate
/// outlives membership, and an employer checking a code in 2034 must still get
/// an answer (dev plan section 4). Deleting a member is therefore blocked
/// while credentials exist - by Restrict, not by anyone remembering.
model Credential {
  id String @id @default(cuid())

  /// The code an employer types, e.g. NM-7K4Q-2X9. Generated from an alphabet
  /// with no 0/O or 1/I, because it gets read off a printout over the phone.
  code String @unique

  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Restrict)

  title        String
  /// "Four sessions, 12 contact hours" is printed from these two, not stored
  /// as prose, so the verification page and the PDF cannot drift apart.
  sessions     Int    @default(1)
  contactHours Int    @default(0)

  issuedAt  DateTime  @default(now())
  /// Set only if a certificate is withdrawn. Verification then reports it as
  /// revoked rather than pretending it was never issued.
  revokedAt DateTime?

  /// Where the printed PDF lives (Vercel Blob in production, disk in dev).
  /// Generated once on first download and reused — a certificate is a
  /// document, and re-rendering it years later must not change a pixel.
  pdfUrl String?

  skills CredentialSkill[]
  checks VerificationCheck[]
  events CredentialEvent[]

  @@index([memberId, issuedAt])
}

/// Which skills a certificate evidences. A join table rather than a string
/// array so the skill list stays one vocabulary across the whole platform.
model CredentialSkill {
  credentialId String
  credential   Credential @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  skillId      String
  skill        Skill      @relation(fields: [skillId], references: [id], onDelete: Restrict)

  @@id([credentialId, skillId])
}

/// Which events a certificate was earned from.
///
/// Without this, nothing connects "Introduction to CAD, session 4" to the
/// certificate that came out of all four sessions, and matching on the title
/// prints the same code against every session - which is worse than printing
/// none, because it looks like four certificates.
model CredentialEvent {
  credentialId String
  credential   Credential @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  eventId      String
  event        Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([credentialId, eventId])
  @@index([eventId])
}

/// Somebody entered a code on the public verification page. Recorded so the
/// member can see that their certificate is being checked - and nothing about
/// who checked it, because the page never asks them to say (design plan 1.4).
model VerificationCheck {
  id           String     @id @default(cuid())
  credentialId String
  credential   Credential @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  checkedAt DateTime @default(now())
  /// False when the code was found but the certificate had been revoked.
  verified  Boolean  @default(true)

  @@index([credentialId, checkedAt])
}

// ---------------------------------------------------------------------------
// Skills. Derived, never self-declared - which is the whole point of them.
// ---------------------------------------------------------------------------

enum SkillLevel {
  INTRODUCED
  PRACTISING
  COMPETENT
  VERIFIED
}

model Skill {
  id   String @id @default(cuid())
  slug String @unique
  name String

  members         MemberSkill[]
  credentials     CredentialSkill[]
  activitySkills  ActivitySkill[]
}

/// A member's level in one skill.
///
/// `level` is derived from attendance, completions and submissions. There is
/// no write path for a member and there must never be one: a list somebody
/// typed about themselves is worth nothing to an employer, and this one is
/// only worth something because nobody could.
///
/// VERIFIED is the single exception, and it still is not self-declared - it
/// needs a named member of staff or industry host in `verifiedBy`.
model MemberSkill {
  id       String @id @default(cuid())
  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  skillId  String
  skill    Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  level SkillLevel @default(INTRODUCED)

  /// The sentences the skills page prints under "How you got here". Held here
  /// rather than regenerated on read so the member sees the same reasons the
  /// derivation saw when it moved them up.
  evidence String[]

  /// Who signed it off, for VERIFIED only. Null at every other level.
  verifiedBy String?
  verifiedAt DateTime?

  updatedAt DateTime @updatedAt

  @@unique([memberId, skillId])
}

// ---------------------------------------------------------------------------
// Everything else the dashboard reads.
// ---------------------------------------------------------------------------

enum ActivityKind {
  CHECKED_IN
  CERTIFICATE_ISSUED
  SKILL_LEVEL_UP
  DELIVERABLE_SUBMITTED
  MEMBERSHIP_APPROVED
}

/// The member's own history, in their words rather than the database's. Append
/// only: it is a record of what happened, so nothing here is ever edited.
model ActivityEntry {
  id       String       @id @default(cuid())
  memberId String
  member   Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  kind     ActivityKind
  summary  String

  occurredAt DateTime @default(now())

  @@index([memberId, occurredAt])
}

/// A placement or internship the branch is passing on. Matched to a member by
/// department and level - a filter, not a recommendation engine.
model Opportunity {
  id           String      @id @default(cuid())
  title        String
  organisation String
  closesAt     DateTime
  /// Null means it is open to both departments.
  department   Department?
  /// Lowest level that may apply. 400 means 400 and above.
  minLevel     Int?

  // Phase 1 additions
  slug             String    @unique
  type             String
  description      String?
  location         String?
  isRemote         Boolean   @default(false)
  externalUrl      String?
  registrationMode String    @default("external")
  status           String    @default("submitted")
  submittedById    String?
  submittedBy      Member?   @relation("OpportunitySubmitter", fields: [submittedById], references: [id], onDelete: SetNull)
  reviewedById     String?
  reviewedBy       Member?   @relation("OpportunityReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  publishedAt      DateTime?

  createdAt DateTime @default(now())

  @@index([closesAt])
  @@index([status, closesAt])
}

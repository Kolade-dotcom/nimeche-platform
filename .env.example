# Copy to .env.local. The app, prisma.config.ts and prisma/seed.ts all read
# .env.local first and .env second, which is the order Next.js uses, so one
# file covers everything. Never commit either. Secrets live in environment
# variables only (dev plan section 9).

# --- Database (Neon Postgres) ----------------------------------------------
# Both come from the Neon dashboard: open the project, press Connect, and read
# the string with "Connection pooling" on and again with it off. Neon's own
# .env snippet calls them DATABASE_URL and DATABASE_URL_UNPOOLED; the second is
# DIRECT_URL here, because that is what Prisma's datasource calls it.
# DATABASE_URL is the POOLED connection - the host contains "-pooler". It is
# what the app uses, because serverless functions open many short connections.
# DIRECT_URL bypasses the pooler and is what migrations need: they run DDL,
# which a connection pooler cannot hold open.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/nimeche?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/nimeche?sslmode=require"

# --- Auth (Auth.js / NextAuth v5) -------------------------------------------
# Signs and encrypts the session cookie. Generate one with:
#   npx auth secret
# Changing it signs everybody out, which is the intended way to do that.
AUTH_SECRET="..."

# --- App --------------------------------------------------------------------
# Used to build absolute URLs, including the verification links printed on
# certificates and the links in emails. Set this to the real domain before
# issuing any certificate.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Email (transactional) --------------------------------------------------
# Without a key, emails are printed to the server console instead of sent, so
# the whole flow is testable before anyone signs up for Resend.
# RESEND_API_KEY="..."
EMAIL_FROM="NiMechE-SF <no-reply@nimeche-aatu.vercel.app>"
